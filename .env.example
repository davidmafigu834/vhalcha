# Copy to .env for local development. Never commit real secrets.

VHALCHA_ENV=development
LOG_LEVEL=info

# Privileged migration and seed connection. This user bypasses row level security.
# Gateway, dashboard, and acceptance use DATABASE_URL as vhalcha_app.
# The worker uses WORKER_DATABASE_URL as vhalcha_worker.
# Run `pnpm db:roles` once after migrate so those roles have local passwords.
DATABASE_ADMIN_URL=postgres://vhalcha:vhalcha@localhost:5432/vhalcha
DATABASE_URL=postgres://vhalcha_app:vhalcha-app-local-dev@localhost:5432/vhalcha
WORKER_DATABASE_URL=postgres://vhalcha_worker:vhalcha-worker-local-dev@localhost:5432/vhalcha
VHALCHA_APP_DB_PASSWORD=vhalcha-app-local-dev
VHALCHA_WORKER_DB_PASSWORD=vhalcha-worker-local-dev

# local is the development object store. Production rejects local and requires s3.
KNOWLEDGE_STORAGE=local
# VHALCHA_SECRETS_KEY encrypts organisation provider credentials. 32 bytes, base64.
# Production rejects values that look like placeholders.
# When this is empty, organisation provider connect is disabled. The platform OpenAI key still works.
VHALCHA_SECRETS_KEY=

# Catalogue prices older than this many days cannot be shown as an optimisation benefit.
# Routing can still use the rate. Default 90.
VHALCHA_MAX_PRICING_AGE_DAYS=90

# Maximum wait for a provider HTTP call before it is treated as unavailable. Default 60000.
VHALCHA_PROVIDER_TIMEOUT_MS=60000

# Redis. Use redis:// in every shared environment.
# memory:// is a single-process development fallback and is refused in production.
REDIS_URL=redis://localhost:6379

# Platform-managed provider credentials. Used when a provider connection
# has credential_source=platform_env. Never log these values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# mock registers only the local mock adapter.
# openai enables OpenAI, Anthropic and Google adapters. Routing selects the provider per request.
# mock is refused in production.
VHALCHA_PROVIDER_MODE=openai

# Public service URLs.
VHALCHA_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_VHALCHA_APP_URL=http://localhost:3000
NEXT_PUBLIC_VHALCHA_GATEWAY_URL=http://localhost:3001

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3001

# Comma-separated browser origins allowed to call the gateway. Empty denies browser origins.
ALLOWED_ORIGINS=

# Dashboard session cookie signer. Minimum 32 characters.
# Production also rejects placeholders and secrets with fewer than 16 distinct characters.
SESSION_SECRET=dev-only-change-this-session-secret-32b

# Optional. Local development starts without Sentry when this is empty.
SENTRY_DSN=

# Development model used by seed data and the sample gateway request.
VHALCHA_DEV_MODEL=gpt-4.1-mini
